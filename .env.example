# Database (SQLite - no setup required)
DATABASE_URL="file:./dev.db"

# Auth - generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial admin user (used once by: npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Find in GA4 > Admin > Data Streams > your stream > Measurement Protocol API secrets
GOOGLE_GA4_MEASUREMENT_ID=""
GOOGLE_GA4_API_SECRET=""

# ─── Google Ads Offline Conversions ──────────────────────────────────────────
# Developer token: Google Ads > Tools > API Centre
# Customer ID: your Google Ads account number (without dashes)
# OAuth credentials: console.cloud.google.com > APIs & Services > Credentials
# Refresh token: use OAuth Playground (oauth.google.com/playground)
# Conversion Action ID: Google Ads > Goals > Conversions > your action > the numeric ID in the URL
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CONVERSION_ACTION_ID=""

# ─── Meta / Facebook Conversions API ─────────────────────────────────────────
# Pixel ID: Events Manager > your pixel > Settings
# Access Token: Events Manager > your pixel > Settings > Conversions API > Generate access token
FACEBOOK_PIXEL_ID=""
FACEBOOK_ACCESS_TOKEN=""

# ─── Google Calendar ─────────────────────────────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
# Application type: Web application
# Authorized redirect URI: {NEXTAUTH_URL}/api/calendar/callback
# Enable: Google Calendar API in the Google Cloud project
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# ─── Webhook Security (optional but recommended) ─────────────────────────────
# Set this and include it as X-Webhook-Secret header in your form platform settings
WEBHOOK_SECRET=""
