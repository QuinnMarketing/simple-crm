generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  webhookToken      String   @unique @default(cuid())
  receiptEmailToken String?  // Token for receipt email address (auto-generated on first use)
  plan              String   @default("starter")
  isActive        Boolean  @default(true)
  featTakeoffs    Boolean  @default(false)
  abn             String?
  businessAddress String?
  businessPhone   String?
  businessEmail   String?
  businessWebsite String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users              User[]
  userAccounts       UserAccount[]
  leads              Lead[]
  companies          Company[]
  integrations       AccountIntegration[]
  appointments       Appointment[]
  quotes             Quote[]
  automations        Automation[]
  timeEntries        TimeEntry[]
  documentTemplates  DocumentTemplate[]
  emailCampaigns     EmailCampaign[]
  customFields       CustomField[]
  slaHours           Int?
  idleAlertDays      Int?
  lastIdleAlertAt    DateTime?
  socialAccounts     SocialAccount[]
  socialPosts        SocialPost[]
  ganttProjects      GanttProject[]
  tasks              Task[]
  bookingSettings    BookingSettings?
  reviews            Review[]
  reviewSettings     ReviewSettings?
  priceItems         PriceItem[]
  documentSettings       DocumentSettings?
  outboundIntegrations   OutboundIntegration[]
  expenses               Expense[]
  pendingReceipts        PendingReceipt[]
  takeoffs               Takeoff[]
  adPlatformAccounts     AdPlatformAccount[]
}

model AccountIntegration {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform  String
  config    String   @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, platform])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("account_user")
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries          TimeEntry[]
  pushSubscriptions    PushSubscription[]
  userAccounts         UserAccount[]
  passwordResetTokens  PasswordResetToken[]
  magicLinkTokens      MagicLinkToken[]
  appointments         Appointment[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAccount {
  userId    String
  accountId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  accountId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      String?
  status      String   @default("new")
  service     String?
  notes       String?
  address     String?
  value       Float?
  formData    String?
  gclid       String?
  fbclid      String?
  fbp         String?
  fbc         String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  utmMatchtype String?
  userAgent   String?
  ipAddress   String?
  pageUrl     String?
  bestTimeToContact   String?
  firstRespondedAt    DateTime?
  nextStep            String?
  nextStepDue         String?
  lostReason          String?
  unsubscribed        Boolean               @default(false)
  companyId           String?
  company     Company? @relation(fields: [companyId], references: [id])
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversions         ConversionEvent[]
  appointments        Appointment[]
  quotes              Quote[]
  timeEntries         TimeEntry[]
  emailCampaignSends  EmailCampaignSend[]
  customFieldValues   CustomFieldValue[]
  tasks               Task[]
  reviews             Review[]
  takeoffs            Takeoff[]
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("todo")    // todo | in_progress | done
  priority     String    @default("medium")  // low | medium | high
  dueDate      DateTime?
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Appointment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean  @default(false)
  location      String?
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId        String?
  assignedTo    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Automation {
  id            String    @id @default(cuid())
  name          String
  description   String?
  enabled       Boolean   @default(true)
  // New-style: steps JSON (AutomationDefinition). Empty object = legacy automation.
  steps         String    @default("{}")
  allowRepeat   Boolean   @default(false)
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  // Legacy fields (kept for existing automations)
  trigger       String    @default("")
  triggerConfig String    @default("{}")
  action        String    @default("")
  actionConfig  String    @default("{}")
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  logs          AutomationLog[]
  runs          AutomationRun[]
}

model AutomationLog {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId       String
  firedAt      DateTime   @default(now())

  @@unique([automationId, leadId])
}

model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  leadId        String?
  status        String     @default("running") // running | completed | failed | waiting
  resumeAt      DateTime?
  resumeAtIndex Int?
  context       String     @default("{}")
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  stepLogs      AutomationStepLog[]

  @@index([automationId])
  @@index([status, resumeAt])
}

model AutomationStepLog {
  id         String        @id @default(cuid())
  runId      String
  run        AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId     String
  stepType   String
  label      String?
  status     String        // completed | failed | skipped
  output     String?
  error      String?
  executedAt DateTime      @default(now())
}

model Quote {
  id        String    @id @default(cuid())
  type      String    // 'quote' | 'invoice'
  number    String
  status    String    @default("draft")
  clientToken String? @unique // one-time token for accept/reject links in emails
  lineItems String    @default("[]") // JSON: [{description,quantity,unitPrice}]
  subtotal  Float     @default(0)
  taxRate   Float     @default(10)
  taxAmount Float     @default(0)
  total     Float     @default(0)
  notes     String?
  issuedAt  DateTime?
  dueAt     DateTime?
  createdByName String?
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TimeEntry {
  id          String   @id @default(cuid())
  type        String   // 'call' | 'meeting' | 'work' | 'email' | 'admin' | 'other'
  description String?
  durationMin Int      // minutes
  startedAt   DateTime
  assignedTo  String?  // free-text name — works for non-registered employees/contractors
  hourlyRate  Float?   // optional rate in account currency
  latitude    Float?
  longitude   Float?
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectId   String?
  project     GanttProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentTemplate {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String   // 'quote' | 'invoice'
  filename  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, type])
}

model AuditLog {
  id          String   @id @default(cuid())
  accountId   String?
  userId      String?
  userEmail   String?
  action      String   // 'lead.created' | 'lead.updated' | 'lead.deleted' | etc.
  entityType  String   // 'lead' | 'quote' | 'appointment' | 'company' | 'user' | 'automation' | 'time_entry'
  entityId    String
  entityLabel String?  // human-readable name at time of action
  changes     String?  // JSON: { field: [oldVal, newVal], ... }
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model ConversionEvent {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform     String
  eventName    String
  value        Float?
  currency     String   @default("AUD")
  status       String   @default("pending")
  response     String?
  errorMessage String?
  sentAt       DateTime @default(now())
}

model EmailCampaign {
  id            String   @id @default(cuid())
  name          String
  subject       String   @default("")
  bodyHtml      String   @default("")
  bodyText      String   @default("")
  status        String   @default("draft") // draft | scheduled | sending | sent | failed
  segmentFilter String   @default("{}") // JSON: { statuses, sources, leadIds }
  trackOpens    Boolean  @default(false)
  trackClicks   Boolean  @default(false)
  scheduledAt   DateTime?
  sentAt        DateTime?
  totalSent     Int      @default(0)
  totalFailed   Int      @default(0)
  lastError     String?
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sends         EmailCampaignSend[]
}

model EmailCampaignSend {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  email      String
  name       String?
  status     String        @default("pending") // pending | sent | failed
  error      String?
  openedAt   DateTime?
  clickedAt  DateTime?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
}

model CustomField {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text") // text | textarea | number | date | select | checkbox
  options   String?  // JSON string array — only used when type = 'select'
  required  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  values CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String?
  updatedAt     DateTime    @updatedAt

  @@unique([leadId, customFieldId])
}

model SocialAccount {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String   // 'facebook' | 'instagram' | 'google_business' | 'linkedin'
  platformId  String   // page/profile ID on the platform
  name        String
  pictureUrl  String?
  accessToken String
  refreshToken String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  targets     SocialPostTarget[]

  @@unique([accountId, platform, platformId])
}

model SocialPost {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  content     String
  mediaUrls   String    @default("[]") // JSON array of image URLs
  link        String?
  scheduledAt DateTime?
  status      String    @default("draft") // draft | scheduled | publishing | published | failed | partial
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  targets     SocialPostTarget[]
}

model SocialPostTarget {
  id              String        @id @default(cuid())
  postId          String
  post            SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          String        @default("pending") // pending | published | failed
  platformPostId  String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
}

model GanttProject {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String      @default("#6366f1")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tasks       GanttTask[]
  expenses    Expense[]
  takeoffs    Takeoff[]
  timeEntries TimeEntry[]

  @@index([accountId])
}

model GanttTask {
  id        String       @id @default(cuid())
  projectId String
  project   GanttProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate String       // YYYY-MM-DD
  endDate   String       // YYYY-MM-DD
  assignee  String?
  status    String       @default("not_started")
  progress  Int          @default(0)
  color     String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Expense {
  id          String       @id @default(cuid())
  projectId   String
  project     GanttProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String       @default("AUD")
  vendor      String?
  category    String?      // e.g., "materials", "labor", "equipment", "other"
  description String?
  date        DateTime
  imageUrl    String?      // URL to receipt/invoice image
  ocrData     String?      // Raw OCR text from image
  status      String       @default("pending") // pending, verified, rejected
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([accountId])
}

model PendingReceipt {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName    String
  imageUrl    String
  amount      Float?
  vendor      String?
  date        DateTime?
  ocrData     String?  // Raw OCR text from image
  notes       String?
  createdAt   DateTime @default(now())

  @@index([accountId])
}

model Review {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  reviewerName  String
  reviewerEmail String?
  rating        Int      // 1-5
  body          String?
  reply         String?
  repliedAt     DateTime?
  source        String   @default("widget") // 'widget' | 'manual' | 'google'
  externalId    String?  // GBP review name for dedup, e.g. accounts/.../locations/.../reviews/...
  status        String   @default("pending") // 'pending' | 'approved' | 'hidden'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, status])
  @@index([externalId])
}

model ReviewSettings {
  id             String   @id @default(cuid())
  accountId      String   @unique
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(true)
  title          String   @default("How was your experience?")
  description    String?
  autoApprove    Boolean  @default(false)
  autoReply      Boolean  @default(false)
  replyTemplates String   @default("{}") // JSON: { positive, neutral, negative, widgetMinRating }
  createdAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PriceItem {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  unit        String   @default("each")
  category    String?
  sku         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, active])
}

model OutboundIntegration {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  url           String
  authType      String   @default("none") // none | bearer | api_key | basic
  authHeader    String?  // custom header name for api_key type (e.g. "X-Api-Key")
  authValue     String?  // token / key / "user:pass" for basic
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
}

model DocumentSettings {
  id             String   @id @default(cuid())
  accountId      String   @unique
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quotePrefix    String   @default("Q-")
  invoicePrefix  String   @default("INV-")
  nextQuoteNum   Int      @default(1)
  nextInvoiceNum Int      @default(1)
  numberPadding  Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BookingSettings {
  id             String   @id @default(cuid())
  accountId      String   @unique
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(true)
  title          String   @default("Book an Appointment")
  description    String?
  slotDuration   Int      @default(60)
  bufferTime     Int      @default(0)
  timezone       String   @default("Australia/Sydney")
  availableHours String   @default("{}")
  maxDaysAhead   Int      @default(60)
  minNoticeHours Int      @default(24)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Takeoff {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId   String?
  project     GanttProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      String        @default("draft") // draft | sent | approved | rejected
  lineItems   String        @default("[]") // JSON: [{id,section,description,quantity,unit,unitCost,markup,total}]
  subtotal    Float         @default(0)
  total       Float         @default(0)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plans       TakeoffPlan[]

  @@index([accountId])
}

model TakeoffPlan {
  id           String   @id @default(cuid())
  takeoffId    String
  takeoff      Takeoff  @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  name         String
  imageData    String   // base64 data URL
  scale        String?  // JSON: {p1,p2,pixelDist,realDist,unit}
  measurements String   @default("[]") // JSON array of measurement objects
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([takeoffId])
}

// ─── Ads Management ───────────────────────────────────────────────────────────

model AdPlatformAccount {
  id                  String   @id @default(cuid())
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform            String   // 'google_ads' | 'meta_ads' | 'tiktok_ads'
  platformAccountId   String
  platformAccountName String
  accessToken         String?
  refreshToken        String?
  expiresAt           DateTime?
  currencyCode        String   @default("AUD")
  timezone            String   @default("Australia/Sydney")
  developerToken      String?
  loginCustomerId     String?  // MCC manager account ID required when accessing client accounts
  enabled             Boolean  @default(true)
  syncedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campaigns AdCampaign[]
  audiences AdAudience[]
  snapshots AdPerformanceSnapshot[]

  @@unique([accountId, platform, platformAccountId])
  @@index([accountId])
}

model AdCampaign {
  id                  String            @id @default(cuid())
  accountId           String
  adPlatformAccountId String
  adPlatformAccount   AdPlatformAccount @relation(fields: [adPlatformAccountId], references: [id], onDelete: Cascade)
  platform            String
  platformCampaignId  String
  name                String
  status              String            @default("paused")
  objective           String?
  budgetType          String?
  budgetAmount        Float?
  budgetCurrency      String            @default("AUD")
  startDate           String?
  endDate             String?
  syncedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  adSets AdSet[]

  @@unique([adPlatformAccountId, platformCampaignId])
  @@index([accountId])
  @@index([adPlatformAccountId])
}

model AdSet {
  id                  String     @id @default(cuid())
  campaignId          String
  campaign            AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adPlatformAccountId String
  platform            String
  platformAdSetId     String
  name                String
  status              String     @default("paused")
  budgetAmount        Float?
  bidStrategy         String?
  bidAmount           Float?
  targeting           String     @default("{}")
  syncedAt            DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  ads AdCreative[]

  @@unique([campaignId, platformAdSetId])
  @@index([campaignId])
}

model AdCreative {
  id             String   @id @default(cuid())
  adSetId        String
  adSet          AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  campaignId     String
  platform       String
  platformAdId   String
  name           String
  status         String   @default("paused")
  format         String?
  headline       String?
  body           String?
  callToAction   String?
  imageUrl       String?
  videoUrl       String?
  destinationUrl String?
  displayUrl     String?
  creativeData   String   @default("{}")
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([adSetId, platformAdId])
  @@index([campaignId])
}

model AdPerformanceSnapshot {
  id                  String            @id @default(cuid())
  accountId           String
  adPlatformAccountId String
  adPlatformAccount   AdPlatformAccount @relation(fields: [adPlatformAccountId], references: [id], onDelete: Cascade)
  platform            String
  entityType          String
  entityId            String
  date                DateTime
  impressions         Int               @default(0)
  clicks              Int               @default(0)
  spend               Float             @default(0)
  conversions         Float             @default(0)
  conversionValue     Float             @default(0)
  ctr                 Float             @default(0)
  cpc                 Float             @default(0)
  cpm                 Float             @default(0)
  roas                Float             @default(0)
  cpl                 Float             @default(0)
  createdAt           DateTime          @default(now())

  @@unique([adPlatformAccountId, entityType, entityId, date])
  @@index([accountId, date])
  @@index([adPlatformAccountId, entityType])
}

model AdAudience {
  id                  String            @id @default(cuid())
  accountId           String
  adPlatformAccountId String
  adPlatformAccount   AdPlatformAccount @relation(fields: [adPlatformAccountId], references: [id], onDelete: Cascade)
  platform            String
  name                String
  description         String?
  segmentFilter       String            @default("{}")
  platformAudienceId  String?
  memberCount         Int               @default(0)
  uploadedAt          DateTime?
  status              String            @default("pending")
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([accountId])
  @@index([adPlatformAccountId])
}
